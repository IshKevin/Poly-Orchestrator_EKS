# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real credentials.

aws_region   = "us-east-1"
project_name = "shopnow"
environment  = "kubeadm"

vpc_cidr             = "10.1.0.0/16"
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24"]
private_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# EC2 key pair — create with: aws ec2 create-key-pair --key-name shopnow-kubeadm --query KeyMaterial --output text > ~/.ssh/shopnow-kubeadm.pem && chmod 400 ~/.ssh/shopnow-kubeadm.pem
key_pair_name = "shopnow-kubeadm"

# Restrict to your IP: curl -s https://checkip.amazonaws.com && echo /32
admin_cidr = "0.0.0.0/0"   # WARNING: restrict to your IP before deploying

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.medium"
worker_count                = 2

db_instance_class = "db.t3.micro"
db_name           = "shopnow"
db_username       = "shopnow"
db_password       = "shopnow_password_change_me"   # Change before deploying

redis_node_type = "cache.t3.micro"
